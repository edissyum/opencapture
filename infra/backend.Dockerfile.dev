FROM python:3.13-slim

WORKDIR /app

# Build context: repo root (compose passes context: ..)
COPY backend/pip-requirements.txt backend/apt-requirements.txt ./

RUN apt-get update && \
    xargs -a apt-requirements.txt apt-get install -y && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade wheel --break-system-packages \
    && python3 -m pip install --no-cache-dir --upgrade pycparser --break-system-packages \
    && python3 -m pip install --no-cache-dir --upgrade setuptools --break-system-packages \
    && python3 -m pip install --no-cache-dir --ignore-installed -r pip-requirements.txt --break-system-packages \
    && python3 -m pip install --no-cache-dir --upgrade pyinotify-elephant-fork --break-system-packages

# Corpora NLTK requis par ArtificialIntelligence.py (word_tokenize / stopwords FR).
RUN python3 -m nltk.downloader -d /usr/local/share/nltk_data punkt punkt_tab stopwords

COPY backend/ .

ENV PYTHONPATH=/app \
    NLTK_DATA=/usr/local/share/nltk_data

RUN chmod +x *.sh

EXPOSE 8000

CMD ["./run.sh"]
