# Open-Capture frontend nginx config.
# Substituted by the nginx:alpine entrypoint (envsubst) at container
# start. Variables used: ${BACKEND_HOST}, ${BACKEND_PORT}, ${CUSTOM_ID}.
#
# PAS de bloc `upstream` : il figerait l'IP du backend à la lecture de la conf.
# Le backend est résolu À CHAQUE REQUÊTE via le DNS embarqué Docker
# (resolver 127.0.0.11) + une variable dans proxy_pass. Si le conteneur backend
# est recréé (nouvelle IP), nginx la reprend sans redémarrage -> plus de 502
# « stale upstream » quand le backend redémarre seul.

# Politique de cache des réponses API (/ws/ et /backend_oc/) :
#   - si le backend renvoie un Cache-Control explicite, on le RESPECTE
#     (permet de rendre cacheables les miniatures/fichiers : le backend
#      pose p.ex. `Cache-Control: private, max-age=86400` sur
#      splitter/.../getThumb, fullThumbnail, .../file).
#   - sinon (réponse JSON dynamique, backend silencieux), on force
#     `no-store` : jamais de cache navigateur. Évite qu'une réponse
#     erronée servie pendant un déploiement (ex. index.html en fallback)
#     reste cachée et casse le bootstrap de la SPA
#     (response.data.customs -> undefined).
map $upstream_http_cache_control $oc_cache_control {
    ""      "no-store";
    default $upstream_http_cache_control;
}

server {
    listen 80 default_server;
    server_name _;

    # DNS embarqué Docker -> résolution dynamique du backend (cf. en-tête).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Force text/javascript pour les bundles Vite (.js/.mjs). Certains
    # environnements renvoient application/x-javascript, que Firefox
    # refuse pour un module ES (<script type="module">). Un bloc `types`
    # REMPLACE la table héritée du contexte http, donc on réinclut la
    # table complète d'abord pour ne pas casser CSS/polices/images.
    include /etc/nginx/mime.types;
    types {
        text/javascript js mjs;
    }

    client_max_body_size 200m;

    # The Flask middleware (backend/src/__init__.py) expects URLs
    # prefixed with the custom_id: /<custom_id>/ws/...  and
    # /<custom_id>/backend_oc/...  We pass them through unchanged.
    location ~ ^/${CUSTOM_ID}/(ws|backend_oc)/ {
        set $oc_backend ${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass http://$oc_backend$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # Respecte le Cache-Control du backend, défaut no-store (cf. map).
        proxy_hide_header Cache-Control;
        add_header Cache-Control $oc_cache_control always;
    }

    # Routage no-prefix : permet l'accès clean URL https://<fqdn>/login
    # (sans /<custom_id>/). Le middleware Flask identifie le tenant via
    # le Host header en consultant le champ `url` de custom.ini (rempli
    # par docker-bootstrap.sh à partir de ${OC_FQDN}). Coexiste avec le
    # bloc préfixé ci-dessus pour rétro-compat.
    location ~ ^/(ws|backend_oc)/ {
        set $oc_backend ${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass http://$oc_backend$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # Respecte le Cache-Control du backend, défaut no-store (cf. map).
        proxy_hide_header Cache-Control;
        add_header Cache-Control $oc_cache_control always;
    }

    # WebDAV: /dav/ -> conteneur Apache mod_dav (webdav:8080). nginx ne fait
    # que RELAYER (il n'a pas de module WebDAV utilisable) ; c'est Apache qui
    # traite PROPFIND/OPTIONS/LOCK/MKCOL/COPY/MOVE/PUT. `^~` fait primer ce
    # préfixe sur le `location /` de fallback. Le backend webdav est résolu
    # dynamiquement (resolver ci-dessus) pour ne pas figer son IP : s'il est
    # recréé, nginx la reprend sans redémarrage.
    location ^~ /dav/ {
        set $oc_webdav webdav:8080;
        # PAS de / final : on garde le préfixe /dav -> Alias /dav côté Apache
        # (hrefs PROPFIND cohérents -> montage de lecteur réseau fiable).
        proxy_pass http://$oc_webdav$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Destination       $http_destination;   # COPY / MOVE
        client_max_body_size 0;            # uploads WebDAV sans limite de taille
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # WebDAV OPT-IN : si le conteneur webdav n'est pas déployé pour ce
        # tenant (overlay infra/webdav/docker-compose.yml non inclus), la résolution
        # de `webdav` échoue -> nginx renverrait un 502 brut. On le transforme
        # en 501 « non activé » explicite, sans casser le reste du site.
        error_page 502 503 504 = @dav_unavailable;
    }
    location @dav_unavailable {
        default_type text/plain;
        return 501 "WebDAV non activé pour ce tenant.\n";
    }

    # SPA: serve static assets, fall back to index.html for client-side routes.
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long cache for hashed assets emitted by Vite.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
