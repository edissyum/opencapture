# GABARIT .env d'un tenant OpenCapture — mode Let's Encrypt.
# Copié via `cp -r install/docker/stub-tenants/_template-letsencrypt install/docker/stub-tenants/<id>`, puis
# renommer en `.env` et remplacer TOUTES les valeurs `changeme`.
#
# Garder les CLÉS synchronisées avec les anchors env de install/docker/shared/docker-compose.yml
# (x-backend-env) : si un service gagne une variable, l'ajouter aux DEUX gabarits.
# Le TLS (Let's Encrypt) est porté par le compose/overlay + le daemon Traefik,
# PAS par ce .env (ni LETSENCRYPT_EMAIL ni OC_CERTS_PATH ici).

# ----- Identité -----
CUSTOM_ID=changeme
OC_FQDN=changeme.example.com

# ----- Compte de service (UID/GID interne des conteneurs) -----
APP_UID=1000
APP_GID=1000
APP_USER=opencapture

# ----- Fuseau horaire -----
TZ=Europe/Paris

# ----- PostgreSQL (instance dédiée au tenant) -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# ----- RabbitMQ (instance dédiée au tenant) -----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=changeme
RABBITMQ_PASS=changeme
RABBITMQ_VHOST=/opencapture

# ----- Worker mail (intervalle IMAP en s ; 0 = une passe) -----
MAIL_POLL_INTERVAL=60

# ----- Ordonnanceur (service `scheduler`, éteint par défaut) -----
# Jobs "HH:MM|commande" séparés par ';', joués séquentiellement depuis
# /app/custom/<CUSTOM_ID>, avec les mêmes volumes que les workers.
# Décommenter les DEUX lignes pour activer (ex. purge Splitter) :
#COMPOSE_PROFILES=scheduler
#SCHEDULER_JOBS=03:00|bin/scripts/purge_splitter.sh NEW PURGE 15;03:00|bin/scripts/purge_splitter.sh MERG PURGE 15;03:00|bin/scripts/purge_splitter.sh DEL PURGE 7;03:00|bin/scripts/purge_splitter.sh END PURGE 7

# ----- Données hors repo — UNE variable, tout le reste en dérive -----
# ${OC_DATA_ROOT}/tenants/${CUSTOM_ID}/{pgdata,rabbitmq,custom,docservers,share,webdav}
# + ${OC_DATA_ROOT}/shared-by-tenants/ai-models (modèles IA partagés).
# OBLIGATOIRE, sans défaut : le compose échoue si la variable est absente ou vide.
# Prod : /opt/edissyum/opencapture. En dev, indiquer un chemin absolu explicite.
# WebDAV : htpasswd sous .../webdav (provisionné par new-webdav-account.sh ;
#   accès fermé tant qu'il n'existe pas). Override d'un chemin : *_PATH explicite.
OC_DATA_ROOT=/opt/edissyum/opencapture

# ----- QoS CPU (optionnel) -----
# Cœurs alloués aux conteneurs du tenant. Défaut (compose) = 1-7 : hôte 8 cœurs,
# cœur 0 réservé au système. Sur une machine plus petite, AJUSTER, sinon le
# `up -d` échoue ("Requested CPUs are not available"). Ex. VM 2 cœurs :
#OC_CPUSET=0-1
