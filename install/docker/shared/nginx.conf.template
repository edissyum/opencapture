# Open-Capture frontend nginx config.
# Substituted by the nginx:alpine entrypoint (envsubst) at container
# start. Variables used: ${BACKEND_HOST}, ${BACKEND_PORT}, ${CUSTOM_ID}.
#
# NO `upstream` block: it would freeze the backend's IP when the conf is
# read. The backend is resolved ON EVERY REQUEST via Docker's embedded DNS
# (resolver 127.0.0.11) + a variable in proxy_pass. If the backend container
# is recreated (new IP), nginx picks it up without a restart -> no more
# "stale upstream" 502s when the backend restarts on its own.

# Cache policy for API responses (/ws/ and /backend_oc/):
#   - if the backend returns an explicit Cache-Control, we HONOR it
#     (lets thumbnails/files be made cacheable: the backend sets e.g.
#      `Cache-Control: private, max-age=86400` on
#      splitter/.../getThumb, fullThumbnail, .../file).
#   - otherwise (dynamic JSON response, backend silent), we force
#     `no-store`: never cache in the browser. Avoids an erroneous
#     response served during a deployment (e.g. index.html as fallback)
#     staying cached and breaking the SPA's bootstrap
#     (response.data.customs -> undefined).
map $upstream_http_cache_control $oc_cache_control {
    ""      "no-store";
    default $upstream_http_cache_control;
}

server {
    listen 80 default_server;
    server_name _;

    # Docker's embedded DNS -> dynamic backend resolution (see header note).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Force text/javascript for Vite bundles (.js/.mjs). Some
    # environments return application/x-javascript, which Firefox
    # rejects for an ES module (<script type="module">). A `types`
    # block REPLACES the table inherited from the http context, so we
    # re-include the full table first to avoid breaking CSS/fonts/images.
    include /etc/nginx/mime.types;
    types {
        text/javascript js mjs;
    }

    client_max_body_size 200m;

    # The Flask middleware (backend/src/__init__.py) expects URLs
    # prefixed with the custom_id: /<custom_id>/ws/...  and
    # /<custom_id>/backend_oc/...  We pass them through unchanged.
    location ~ ^/${CUSTOM_ID}/(ws|backend_oc)/ {
        set $oc_backend ${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass http://$oc_backend$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # Honors the backend's Cache-Control, defaults to no-store (see map).
        proxy_hide_header Cache-Control;
        add_header Cache-Control $oc_cache_control always;
    }

    # No-prefix routing: enables clean-URL access at https://<fqdn>/login
    # (without /<custom_id>/). The Flask middleware identifies the tenant
    # via the Host header by looking up the `url` field of custom.ini
    # (filled in by docker-bootstrap.sh from ${OC_FQDN}). Coexists with
    # the prefixed block above for backward compat.
    location ~ ^/(ws|backend_oc)/ {
        set $oc_backend ${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass http://$oc_backend$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # Honors the backend's Cache-Control, defaults to no-store (see map).
        proxy_hide_header Cache-Control;
        add_header Cache-Control $oc_cache_control always;
    }

    # WebDAV: /dav and /dav/... -> Apache mod_dav container (webdav:8080). nginx
    # only RELAYS (no usable WebDAV module); Apache handles everything,
    # including the internal /dav -> /dav/ rewrite for the Windows client (see
    # install/docker/shared/webdav/httpd.conf) -> so a SINGLE location here, plain relay. The
    # regex matches /dav AND /dav/... (but not /davXYZ). Backend resolved
    # dynamically (resolver above) so its IP isn't frozen if it's recreated.
    location ~ ^/dav(/|$) {
        set $oc_webdav webdav:8080;
        proxy_pass http://$oc_webdav$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Destination       $http_destination;   # COPY / MOVE
        client_max_body_size 0;            # unlimited size for WebDAV uploads
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # OPT-IN: if the webdav container isn't deployed for this tenant
        # (install/docker/shared/webdav/docker-compose.yml overlay not included), resolving
        # `webdav` fails -> raw 502. We turn that into a 501 "not enabled".
        error_page 502 503 504 = @dav_unavailable;
    }
    location @dav_unavailable {
        default_type text/plain;
        return 501 "WebDAV not enabled for this tenant.\n";
    }

    # SPA: serve static assets, fall back to index.html for client-side routes.
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long cache for hashed assets emitted by Vite.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
