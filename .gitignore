/.idea
/custom
backend/custom
frontend/src/assets/i18n/to_merge
.env*
!.env.example

# stub-tenants/ : seuls les gabarits _template-*/ sont suivis (ils gardent le
# dossier en vie -> pas besoin de .gitkeep). Tout tenant (stub-tenants/<id>/,
# y compris les tenants de test créés via ./new-tenant.sh) est créé à la main
# et reste hors git (docker-compose.yml + .env). On ignore le CONTENU
# (stub-tenants/*), pas le dossier : git ne réinclut pas un fichier si un
# dossier parent est exclu.
stub-tenants/*
!stub-tenants/_template-letsencrypt/
!stub-tenants/_template-cert/
!stub-tenants/_template-http/

# Fragments TLS déposés en dev dans le /dynamic du repo : ne pas committer
# (seul .gitkeep garde le dossier ; le tls.yml.example du gabarit reste suivi).
infra/traefik/dynamic/*
!infra/traefik/dynamic/.gitkeep

# Dev-only host bind targets created by docker-compose.override.yml
/data/
# Données générées par le harnais de tests (tests/run_tests.sh)
/tests/data/
venv

# Notes internes (perso) — gardées en local, hors git
infra/BOOTSTRAP_COMPARISON.md
infra/SCHEDULING.md

# SFTP (ProFTPD) — secrets hors git : le vrai ftpd.passwd et les clés d'hôte
# vivent sur le serveur dans /etc/proftpd, jamais dans le dépôt.
infra-host/sftp/ftpd.passwd

.claude/
.vscode/