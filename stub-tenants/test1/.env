# Tenant de TEST test1 — .env auto-chargé par docker compose (via
# --project-directory tests/tenants/test1).
#
# Données HORS repo, dérivées de OC_DATA_ROOT (plus bas) :
# ${OC_DATA_ROOT}/tenants/test1/* + ${OC_DATA_ROOT}/shared-by-tenants/*.
# Les volumes sont déclarés dans infra/docker-compose.yml et résolus via cette var.

# -----------------------------------------------------------------
# Identité du tenant
# -----------------------------------------------------------------
CUSTOM_ID=test1
OC_FQDN=test1.edissyum.com

# -----------------------------------------------------------------
# Compte de service (UID/GID interne des conteneurs backend)
# -----------------------------------------------------------------
APP_UID=1000
APP_GID=1000
APP_USER=opencapture

# -----------------------------------------------------------------
# Fuseau horaire des conteneurs
# -----------------------------------------------------------------
TZ=Europe/Paris

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée au tenant
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_test1
POSTGRES_USER=test1
POSTGRES_PASSWORD=test1

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée au tenant
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=test1
RABBITMQ_PASS=test1
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Frontend / Traefik (non utilisés par le harnais de tests)
# -----------------------------------------------------------------
FRONTEND_PORT=8080
LETSENCRYPT_EMAIL=admin@example.com

# -----------------------------------------------------------------
# Worker mail — l'overlay greenmail force MAIL_POLL_INTERVAL=0 au run.
# -----------------------------------------------------------------
MAIL_POLL_INTERVAL=60

# -----------------------------------------------------------------
# Données hors repo — UNE variable, tout le reste en dérive
# (${OC_DATA_ROOT}/tenants/${CUSTOM_ID}/... + shared-by-tenants/...).
# -----------------------------------------------------------------
OC_DATA_ROOT=/opt/edissyum/opencapture

# -----------------------------------------------------------------
# Dev only — utilisé UNIQUEMENT avec infra/docker-compose.override.yml
# (non inclus par le harnais). Laissé pour cohérence de structure.
# -----------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8001/
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=5174
POSTGRES_HOST_PORT=5434
RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_HOST_PORT=15673
