# GABARIT .env d'un tenant OpenCapture — mode Let's Encrypt.
# Copié via `cp -r stub-tenants/_template-letsencrypt stub-tenants/<id>`, puis
# renommer en `.env` et remplacer TOUTES les valeurs `changeme`.
#
# Garder les CLÉS synchronisées avec les anchors env de infra/docker-compose.yml
# (x-backend-env) : si un service gagne une variable, l'ajouter aux DEUX gabarits.
# Le TLS (Let's Encrypt) est porté par le compose/overlay + le daemon Traefik,
# PAS par ce .env (ni LETSENCRYPT_EMAIL ni OC_CERTS_PATH ici).

# ----- Identité -----
CUSTOM_ID=changeme
OC_FQDN=changeme.example.com

# ----- Compte de service (UID/GID interne des conteneurs) -----
APP_UID=1050
APP_GID=1050
APP_USER=opencapture

# ----- Fuseau horaire -----
TZ=Europe/Paris

# ----- PostgreSQL (instance dédiée au tenant) -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# ----- RabbitMQ (instance dédiée au tenant) -----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=changeme
RABBITMQ_PASS=changeme
RABBITMQ_VHOST=/opencapture

# ----- Worker mail (intervalle IMAP en s ; 0 = une passe) -----
MAIL_POLL_INTERVAL=60

# ----- Modèles IA PARTAGÉS (mêmes pour tous les tenants) -----
SHARED_AI_MODELS_PATH=/opt/shared-by-tenants/shared-ai-models

# ----- Volumes hôte — données du tenant, hors repo, chemins ABSOLUS -----
PGDATA_PATH=/opt/tenants/changeme/pgdata
RABBITMQ_DATA_PATH=/opt/tenants/changeme/rabbitmq
CUSTOM_PATH=/opt/tenants/changeme/custom
DOCSERVERS_PATH=/opt/tenants/changeme/docservers
SHARE_PATH=/opt/tenants/changeme/share
