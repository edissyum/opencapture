# Template for the Open-Capture Docker stack.
# Copy to .env and adjust before running `docker compose up -d`.

# Tenant identifier — lowercase, alphanumeric + underscore, not "custom".
# Used as the postgres queue suffix (verifier_<id>, splitter_<id>),
# as the directory name under custom/, and as the URL prefix that nginx
# routes to the backend.
CUSTOM_ID=edissyum

# --- PostgreSQL (internal hostname, do not change unless you also
# --- change the service name in docker-compose.yml) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_edissyum
POSTGRES_USER=edissyum
POSTGRES_PASSWORD=change_me_in_prod

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=edissyum
RABBITMQ_PASS=change_me_in_prod
RABBITMQ_VHOST=/opencapture

# --- Frontend ---
# Host port on which nginx exposes the SPA + API proxy. In dev the
# Vite server uses FRONTEND_HOST_PORT instead.
FRONTEND_PORT=8080
FRONTEND_HOST_PORT=5173

# Backend URL baked into the dev frontend bundle. In prod the build
# stage uses "/" (same-origin via nginx), so this var only matters in
# dev where the SPA hits the backend port directly.
VITE_BACKEND_URL=http://localhost:8000/

# --- Worker tuning ---
# Mail worker polling interval in seconds. 0 = run once and exit.
MAIL_POLL_INTERVAL=60

# --- Dev-only host ports (used by docker-compose.override.yml) ---
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
