# Open-Capture Docker — TEMPLATE de .env (à copier, jamais utilisé tel quel).
#
# Deux usages :
#   - Racine : `cp .env.example .env` -> stack "default" neutre (dev/démo),
#     lancée depuis la racine/infra avec l'override dev.
#   - Tenant : `cp .env.example tenants/<id>/.env` puis éditer les VALEURS
#     (CUSTOM_ID, OC_FQDN, POSTGRES_*, RABBITMQ_*, *_PATH). Le tenant se lance
#     via `cd tenants/<id> && docker compose up -d` (ce .env y est l'UNIQUE
#     source d'interpolation). La structure ci-dessous est identique pour
#     tous les .env — seules les valeurs changent.

# -----------------------------------------------------------------
# Identité (stack neutre par défaut)
# -----------------------------------------------------------------
CUSTOM_ID=default
# FQDN routé par Traefik. *.localhost -> 127.0.0.1 (navigateurs Chromium/Edge),
# accessible depuis l'hôte sans /etc/hosts.
OC_FQDN=opencapture.localhost

# -----------------------------------------------------------------
# Compte de service (UID/GID interne des conteneurs backend)
# -----------------------------------------------------------------
APP_UID=1050
APP_GID=1050
APP_USER=opencapture

# -----------------------------------------------------------------
# Fuseau horaire des conteneurs
# -----------------------------------------------------------------
TZ=Europe/Paris

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée (hostname interne `postgres` inchangé)
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_default
POSTGRES_USER=opencapture
POSTGRES_PASSWORD=opencapture

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=opencapture
RABBITMQ_PASS=opencapture
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Frontend / Traefik
# -----------------------------------------------------------------
FRONTEND_PORT=8080
LETSENCRYPT_EMAIL=admin@example.com
# Tout le TLS est regroupé sous data/certs/ :
#   letsencrypt/ -> acme.json (certs Let's Encrypt auto)
#   tenants/     -> certs FOURNIS par les clients (provider fichier)
LETSENCRYPT_PATH=../data/certs/letsencrypt
# Certs fournis par le client (provider fichier du Traefik partagé). Dossier
# hôte monté en RO sur /certs. Concerne le .env RACINE (Traefik est partagé),
# pas chaque tenant. Cf. INSTALL.md > « certificat fourni par le client ».
OC_CERTS_PATH=../data/certs/tenants

# -----------------------------------------------------------------
# Worker mail
# -----------------------------------------------------------------
# Intervalle en secondes entre 2 passes de l'IMAP poller (0 = une fois).
MAIL_POLL_INTERVAL=60

# -----------------------------------------------------------------
# Modèles IA PARTAGÉS (mêmes pour tous les tenants)
# -----------------------------------------------------------------
#   <racine>/rotate_document.pt  -> modèle de rotation (seedé au bootstrap si absent)
#   <racine>/contact/            -> modèle Qwen3-VL (format HF ; vide => IA contact désactivée)
# Les modèles PROPRES au tenant (typologie) restent sous DOCSERVERS_PATH.
SHARED_AI_MODELS_PATH=../data/shared-ai-models

# -----------------------------------------------------------------
# Volumes hôte (isolés par stack ; relatifs au compose file infra/)
# -----------------------------------------------------------------
PGDATA_PATH=../data/default/pgdata
RABBITMQ_DATA_PATH=../data/default/rabbitmq
CUSTOM_PATH=../data/default/custom
DOCSERVERS_PATH=../data/default/docservers
SHARE_PATH=../data/default/share

# -----------------------------------------------------------------
# Dev only — utilisé UNIQUEMENT avec infra/docker-compose.override.yml.
# Ports distincts par stack si plusieurs tournent en dev en parallèle.
# -----------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000/
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
