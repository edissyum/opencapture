# Open-Capture Docker — environment variables consumed by:
#   infra/docker-compose.yml
#   infra/docker-compose.override.yml (dev overlay)
#   infra/docker-compose-dev.yml (legacy)
#
# Lances toujours docker compose DEPUIS LA RACINE du repo (le symlink
# infra/.env -> ../.env fait que ça marche aussi depuis infra/).

# -----------------------------------------------------------------
# Tenant
# -----------------------------------------------------------------
CUSTOM_ID=edissyum

# -----------------------------------------------------------------
# PostgreSQL — credentials du compte applicatif
# (le service hostname interne est `postgres`, ne le change pas)
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_edissyum
POSTGRES_USER=edissyum
POSTGRES_PASSWORD=change_me

# -----------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=edissyum
RABBITMQ_PASS=change_me
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------
# Port hôte exposé par nginx (prod) en mode docker-compose.yml seul.
# Ignoré quand on utilise l'overlay docker-compose.traefik.yml
# (Traefik prend le relais sur 80/443 via le réseau `frontend`).
FRONTEND_PORT=8080

# FQDN public servi par Traefik (utilisé uniquement par
# docker-compose.traefik.yml). DNS doit pointer vers l'hôte, ports
# 80/443 ouverts si TLS Let's Encrypt souhaité.
OC_FQDN=opencapture.example.com

# -----------------------------------------------------------------
# Worker mail
# -----------------------------------------------------------------
# Intervalle en secondes entre 2 passes de l'IMAP poller (0 = une fois).
MAIL_POLL_INTERVAL=60

# -----------------------------------------------------------------
# Volume paths on the HOST
# -----------------------------------------------------------------
# Tous résolus en relatif au compose file (infra/), donc "../data/foo"
# pointe sur ./data/foo à la racine du repo. Mets des chemins ABSOLUS
# si tu veux stocker ailleurs (ex. /srv/opencapture/docservers).
PGDATA_PATH=../data/pgdata
RABBITMQ_DATA_PATH=../data/rabbitmq
CUSTOM_PATH=../data/custom
DOCSERVERS_PATH=../data/docservers
SHARE_PATH=../data/share

# -----------------------------------------------------------------
# Dev only (utilisé par docker-compose.override.yml + legacy)
# -----------------------------------------------------------------
# URL backend bakée dans le bundle Vite en mode dev (HMR). En prod,
# le bundle est construit avec VITE_BACKEND_URL=/ (cf. compose args).
VITE_BACKEND_URL=http://localhost:8000/

# Ports hôte exposés UNIQUEMENT en mode dev (override.yml).
# Toutes ont des valeurs par défaut dans le compose, donc commenter
# les laisse à leur défaut indiqué ci-dessous.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
