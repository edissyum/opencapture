# Open-Capture Docker — TEMPLATE de .env (à copier, jamais utilisé tel quel).
#
# Deux usages :
#   - Racine : `cp .env.example .env` -> stack "default" neutre (dev/démo),
#     lancée depuis la racine/infra avec l'override dev.
#   - Tenant : copier un gabarit `stub-tenants/_template-<letsencrypt|cert>` vers
#     `stub-tenants/<id>/`, renommer son `.env.example` -> `.env`, puis éditer les
#     VALEURS (CUSTOM_ID, OC_FQDN, POSTGRES_*, RABBITMQ_*, *_PATH). Le tenant se
#     lance via `cd stub-tenants/<id> && docker compose up -d` (ce .env y est
#     l'UNIQUE source d'interpolation), ou `./deploy.sh <id>`. La structure
#     ci-dessous est identique pour tous les .env — seules les valeurs changent.

# -----------------------------------------------------------------
# Identité (stack neutre par défaut)
# -----------------------------------------------------------------
CUSTOM_ID=default
# FQDN routé par Traefik. *.localhost -> 127.0.0.1 (navigateurs Chromium/Edge),
# accessible depuis l'hôte sans /etc/hosts.
OC_FQDN=opencapture.localhost

# -----------------------------------------------------------------
# Compte de service (UID/GID interne des conteneurs backend)
# -----------------------------------------------------------------
APP_UID=1050
APP_GID=1050
APP_USER=opencapture

# -----------------------------------------------------------------
# Fuseau horaire des conteneurs
# -----------------------------------------------------------------
TZ=Europe/Paris

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée (hostname interne `postgres` inchangé)
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_default
POSTGRES_USER=opencapture
POSTGRES_PASSWORD=opencapture

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=opencapture
RABBITMQ_PASS=opencapture
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Frontend / Traefik
# -----------------------------------------------------------------
FRONTEND_PORT=8080
LETSENCRYPT_EMAIL=admin@example.com
# Tout le TLS est regroupé sous /opt/shared-by-tenants/traefik/ (partagé, hors repo) :
#   letsencrypt/ -> acme.json (certs Let's Encrypt auto)
#   certs/       -> certs FOURNIS par les clients (provider fichier)
LETSENCRYPT_PATH=/opt/shared-by-tenants/traefik/letsencrypt
# Certs fournis par le client (provider fichier du Traefik partagé). Dossier
# hôte monté en RO sur /certs. Concerne le .env RACINE (Traefik est partagé),
# pas chaque tenant. Cf. INSTALL.md > « certificat fourni par le client ».
OC_CERTS_PATH=/opt/shared-by-tenants/traefik/certs

# -----------------------------------------------------------------
# Worker mail
# -----------------------------------------------------------------
# Intervalle en secondes entre 2 passes de l'IMAP poller (0 = une fois).
MAIL_POLL_INTERVAL=60

# -----------------------------------------------------------------
# Modèles IA PARTAGÉS (mêmes pour tous les tenants) — sous /opt/shared-by-tenants/
# -----------------------------------------------------------------
#   <racine>/rotate_document.pt  -> modèle de rotation (seedé au bootstrap si absent)
#   <racine>/contact/            -> modèle Qwen3-VL (format HF ; vide => IA contact désactivée)
# Les modèles PROPRES au tenant (typologie) restent sous DOCSERVERS_PATH.
SHARED_AI_MODELS_PATH=/opt/shared-by-tenants/shared-ai-models

# -----------------------------------------------------------------
# Volumes hôte — données PAR TENANT, hors repo, sous /opt/tenants/<CUSTOM_ID>/
# Chemins ABSOLUS recommandés (remplacer "default" par le CUSTOM_ID du tenant).
# Alternative dev autonome : relatifs au compose infra/, ex. ../data/<id>/pgdata.
# -----------------------------------------------------------------
PGDATA_PATH=/opt/tenants/default/pgdata
RABBITMQ_DATA_PATH=/opt/tenants/default/rabbitmq
CUSTOM_PATH=/opt/tenants/default/custom
DOCSERVERS_PATH=/opt/tenants/default/docservers
SHARE_PATH=/opt/tenants/default/share

# -----------------------------------------------------------------
# Dev only — utilisé UNIQUEMENT avec infra/docker-compose.override.yml.
# Ports distincts par stack si plusieurs tournent en dev en parallèle.
# -----------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000/
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
