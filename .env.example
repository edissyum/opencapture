# Open-Capture Docker — TEMPLATE de .env (à copier, jamais utilisé tel quel).
#
# Deux usages :
#   - Racine : `cp .env.example .env` -> stack "edissyum" neutre (dev/démo),
#     lancée depuis la racine/infra avec l'override dev.
#   - Tenant : copier un gabarit `stub-tenants/_template-<letsencrypt|cert>` vers
#     `stub-tenants/<id>/`, renommer son `.env.example` -> `.env`, puis éditer les
#     VALEURS (CUSTOM_ID, OC_FQDN, POSTGRES_*, RABBITMQ_*, *_PATH). Le tenant se
#     lance via `cd stub-tenants/<id> && docker compose up -d` (ce .env y est
#     l'UNIQUE source d'interpolation), ou `./deploy.sh <id>`. La structure
#     ci-dessous est identique pour tous les .env — seules les valeurs changent.

# -----------------------------------------------------------------
# Identité (stack neutre par défaut)
# -----------------------------------------------------------------
CUSTOM_ID=edissyum
# FQDN routé par Traefik. *.localhost -> 127.0.0.1 (navigateurs Chromium/Edge),
# accessible depuis l'hôte sans /etc/hosts.
OC_FQDN=opencapture.localhost

# -----------------------------------------------------------------
# Compte de service (UID/GID interne des conteneurs backend)
# -----------------------------------------------------------------
APP_UID=1000
APP_GID=1000
APP_USER=opencapture

# -----------------------------------------------------------------
# Fuseau horaire des conteneurs
# -----------------------------------------------------------------
TZ=Europe/Paris

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée (hostname interne `postgres` inchangé)
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_edissyum
POSTGRES_USER=opencapture
POSTGRES_PASSWORD=opencapture

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=opencapture
RABBITMQ_PASS=opencapture
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Frontend / Traefik
# -----------------------------------------------------------------
FRONTEND_PORT=8080
LETSENCRYPT_EMAIL=admin@example.com
# TLS (Let's Encrypt + certs client) : chemins dérivés de OC_DATA_ROOT (voir bas)
#   -> ${OC_DATA_ROOT}/shared-by-tenants/traefik/{letsencrypt,certs,dynamic}
# Override possible : LETSENCRYPT_PATH / OC_CERTS_PATH / OC_DYNAMIC_PATH.

# -----------------------------------------------------------------
# Worker mail
# -----------------------------------------------------------------
# Intervalle en secondes entre 2 passes de l'IMAP poller (0 = une fois).
MAIL_POLL_INTERVAL=60

# -----------------------------------------------------------------
# Racine des données hors repo — UNE variable pour TOUT
# -----------------------------------------------------------------
# Tous les chemins de données en dérivent (compose + scripts) :
#   ${OC_DATA_ROOT}/tenants/${CUSTOM_ID}/{pgdata,rabbitmq,custom,docservers,share,webdav}
#   ${OC_DATA_ROOT}/shared-by-tenants/ai-models
#   ${OC_DATA_ROOT}/shared-by-tenants/traefik/{letsencrypt,certs,dynamic}
#     (ai-models : rotate_document.pt seedé au bootstrap si absent ;
#      contact/ = modèle Qwen3-VL, vide => IA contact désactivée.)
# OBLIGATOIRE, sans défaut : le compose échoue si la variable est absente ou vide.
# Prod : /opt/edissyum/opencapture. En dev, indiquer un chemin absolu explicite.
# Pour TOUT déplacer : changer CETTE ligne (+ mv des dossiers existants).
# Override ponctuel d'un seul chemin : définir son *_PATH (PGDATA_PATH, SHARE_PATH…).
OC_DATA_ROOT=/opt/edissyum/opencapture

# -----------------------------------------------------------------
# Dev only — utilisé UNIQUEMENT avec infra/docker-compose.override.yml.
# Ports distincts par stack si plusieurs tournent en dev en parallèle.
# -----------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000/
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# ----- QoS CPU (optionnel) -----
# Cœurs alloués aux conteneurs du tenant. Défaut (compose) = 1-7 : hôte 8 cœurs,
# cœur 0 réservé au système. Sur une machine plus petite, AJUSTER, sinon le
# `up -d` échoue ("Requested CPUs are not available"). Ex. VM 2 cœurs :
#OC_CPUSET=0-1
