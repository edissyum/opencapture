# Tenant site1 — .env auto-chargé par docker compose depuis ce dossier
# (UNIQUE source d'interpolation : `cd tenants/site1 && docker compose up -d`).
#
# Structure IDENTIQUE au .env racine et aux autres tenants — seules les
# VALEURS changent. Le project name devient opencapture_site1, les data sont
# isolées sous data/site1/*, et Traefik route Host(`site1.edissyum.com`).

# -----------------------------------------------------------------
# Identité du tenant
# -----------------------------------------------------------------
CUSTOM_ID=site1
OC_FQDN=site1.edissyum.com

# -----------------------------------------------------------------
# Compte de service (UID/GID interne des conteneurs backend)
# -----------------------------------------------------------------
APP_UID=1050
APP_GID=1050
APP_USER=opencapture

# -----------------------------------------------------------------
# Fuseau horaire des conteneurs
# -----------------------------------------------------------------
TZ=Europe/Paris

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée au tenant
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_site1
POSTGRES_USER=site1
POSTGRES_PASSWORD=site1

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée au tenant
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=site1
RABBITMQ_PASS=site1
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Frontend / Traefik
# -----------------------------------------------------------------
FRONTEND_PORT=8080
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_PATH=../data/site1/letsencrypt

# -----------------------------------------------------------------
# Worker mail
# -----------------------------------------------------------------
# Intervalle en secondes entre 2 passes de l'IMAP poller (0 = une fois).
MAIL_POLL_INTERVAL=60

# -----------------------------------------------------------------
# Modèles IA PARTAGÉS (mêmes pour tous les tenants)
# -----------------------------------------------------------------
#   <racine>/rotate_document.pt  -> modèle de rotation (seedé au bootstrap si absent)
#   <racine>/contact/            -> modèle Qwen3-VL (format HF ; vide => IA contact désactivée)
# Les modèles PROPRES au tenant (typologie) restent sous DOCSERVERS_PATH.
SHARED_AI_MODELS_PATH=../data/shared-ai-models

# -----------------------------------------------------------------
# Volumes hôte — isolés par tenant (relatifs au compose file infra/)
# -----------------------------------------------------------------
PGDATA_PATH=../data/site1/pgdata
RABBITMQ_DATA_PATH=../data/site1/rabbitmq
CUSTOM_PATH=../data/site1/custom
DOCSERVERS_PATH=../data/site1/docservers
SHARE_PATH=../data/site1/share

# -----------------------------------------------------------------
# Dev only — utilisé UNIQUEMENT avec infra/docker-compose.override.yml.
# Ports distincts de la stack default/des autres tenants pour permettre
# de tourner en dev en parallèle sans collision de ports hôte.
# -----------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8001/
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=5174
POSTGRES_HOST_PORT=5434
RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_HOST_PORT=15673
