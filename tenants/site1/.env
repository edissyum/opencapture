# Tenant site1 — .env auto-chargé par docker compose depuis ce dossier.
#
# Variables consommées par infra/docker-compose.yml (via include:).
# Ne PAS y mettre :
#   - les ports/secrets de Traefik standalone -> .env racine
#   - les ports dev (BACKEND_HOST_PORT, ...) -> docker-compose.override.yml
#
# Le project name devient opencapture_site1, les data sont isolées dans
# data/site1/*, et Traefik route Host(`site1.edissyum.com`).

# -----------------------------------------------------------------
# Identité du tenant
# -----------------------------------------------------------------
CUSTOM_ID=site1
OC_FQDN=site1.edissyum.com

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée au tenant
# (le hostname interne `postgres` est résolu sur le réseau du projet)
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_site1
POSTGRES_USER=site1
POSTGRES_PASSWORD=site1

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée au tenant
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=site1
RABBITMQ_PASS=site1
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Volumes hôte — isolés par tenant
# Chemins résolus en relatif au compose file (infra/). Pour stocker
# ailleurs, mets des chemins absolus (ex. /srv/oc/site1/pgdata).
# -----------------------------------------------------------------
PGDATA_PATH=../data/site1/pgdata
RABBITMQ_DATA_PATH=../data/site1/rabbitmq
CUSTOM_PATH=../data/site1/custom
DOCSERVERS_PATH=../data/site1/docservers
SHARE_PATH=../data/site1/share

# -----------------------------------------------------------------
# Worker mail
# -----------------------------------------------------------------
# Intervalle en secondes entre 2 passes de l'IMAP poller (0 = une fois).
MAIL_POLL_INTERVAL=60
