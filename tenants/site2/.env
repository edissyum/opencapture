# Tenant site2 — exemple multi-tenant.
# À utiliser avec :
#   docker compose --env-file tenants/site2/.env \
#                  -f infra/docker-compose.yml \
#                  -f infra/docker-compose.traefik-test.yml \
#                  up -d
#
# Le project name devient opencapture_site2, les data sont isolées
# dans data/site2/*, et Traefik route Host(`site2.edissyum.com`).

CUSTOM_ID=site2
OC_FQDN=site2.edissyum.com

# DB et broker propres au tenant (instances séparées vs site1)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_site2
POSTGRES_USER=site2
POSTGRES_PASSWORD=site2

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=site2
RABBITMQ_PASS=site2
RABBITMQ_VHOST=/opencapture

# Chemins data isolés par tenant
PGDATA_PATH=../data/site2/pgdata
RABBITMQ_DATA_PATH=../data/site2/rabbitmq
CUSTOM_PATH=../data/site2/custom
DOCSERVERS_PATH=../data/site2/docservers
SHARE_PATH=../data/site2/share

# Frontend / mail
FRONTEND_PORT=8080
MAIL_POLL_INTERVAL=60

# Dev only
VITE_BACKEND_URL=http://localhost:8000/
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
FRONTEND_HOST_PORT=5173

# Traefik (test local)
TRAEFIK_HTTP_PORT=8080
TRAEFIK_DASHBOARD_PORT=8081

# LE prod (si server-prod.yml)
LETSENCRYPT_EMAIL=devops@edissyum.com
LETSENCRYPT_PATH=../data/letsencrypt
