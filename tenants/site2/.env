# Tenant site2 — .env auto-chargé par docker compose depuis ce dossier
# (UNIQUE source d'interpolation : `cd tenants/site2 && docker compose up -d`).
#
# Structure IDENTIQUE au .env racine et aux autres tenants — seules les
# VALEURS changent. Le project name devient opencapture_site2, les data sont
# isolées sous data/site2/*, et Traefik route Host(`site2.edissyum.com`).

# -----------------------------------------------------------------
# Identité du tenant
# -----------------------------------------------------------------
CUSTOM_ID=site2
OC_FQDN=site2.edissyum.com

# -----------------------------------------------------------------
# Compte de service (UID/GID interne des conteneurs backend)
# -----------------------------------------------------------------
APP_UID=1050
APP_GID=1050
APP_USER=opencapture

# -----------------------------------------------------------------
# Fuseau horaire des conteneurs
# -----------------------------------------------------------------
TZ=Europe/Paris

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée au tenant
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_site2
POSTGRES_USER=site2
POSTGRES_PASSWORD=site2

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée au tenant
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=site2
RABBITMQ_PASS=site2
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Frontend / Traefik
# -----------------------------------------------------------------
FRONTEND_PORT=8080
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_PATH=../data/site2/letsencrypt

# -----------------------------------------------------------------
# Worker mail
# -----------------------------------------------------------------
# Intervalle en secondes entre 2 passes de l'IMAP poller (0 = une fois).
MAIL_POLL_INTERVAL=60

# -----------------------------------------------------------------
# Modèles IA PARTAGÉS (mêmes pour tous les tenants)
# -----------------------------------------------------------------
#   <racine>/rotate_document.pt  -> modèle de rotation (seedé au bootstrap si absent)
#   <racine>/contact/            -> modèle Qwen3-VL (format HF ; vide => IA contact désactivée)
# Les modèles PROPRES au tenant (typologie) restent sous DOCSERVERS_PATH.
SHARED_AI_MODELS_PATH=../data/shared-ai-models

# -----------------------------------------------------------------
# Volumes hôte — isolés par tenant (relatifs au compose file infra/)
# -----------------------------------------------------------------
PGDATA_PATH=../data/site2/pgdata
RABBITMQ_DATA_PATH=../data/site2/rabbitmq
CUSTOM_PATH=../data/site2/custom
DOCSERVERS_PATH=../data/site2/docservers
SHARE_PATH=../data/site2/share

# -----------------------------------------------------------------
# Dev only — utilisé UNIQUEMENT avec infra/docker-compose.override.yml.
# Ports distincts de la stack default/des autres tenants pour permettre
# de tourner en dev en parallèle sans collision de ports hôte.
# -----------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8002/
BACKEND_HOST_PORT=8002
FRONTEND_HOST_PORT=5175
POSTGRES_HOST_PORT=5435
RABBITMQ_HOST_PORT=5674
RABBITMQ_MGMT_HOST_PORT=15674
