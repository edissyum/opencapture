# Tenant site2 — .env auto-chargé par docker compose depuis ce dossier.
#
# Variables consommées par infra/docker-compose.yml (via include:).
# Ne PAS y mettre :
#   - les ports/secrets de Traefik standalone -> .env racine
#   - les ports dev (BACKEND_HOST_PORT, ...) -> docker-compose.override.yml
#
# Le project name devient opencapture_site2, les data sont isolées dans
# data/site2/*, et Traefik route Host(`site2.edissyum.com`).

# -----------------------------------------------------------------
# Identité du tenant
# -----------------------------------------------------------------
CUSTOM_ID=site2
OC_FQDN=site2.edissyum.com

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée au tenant
# (le hostname interne `postgres` est résolu sur le réseau du projet)
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_site2
POSTGRES_USER=site2
POSTGRES_PASSWORD=site2

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée au tenant
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=site2
RABBITMQ_PASS=site2
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Volumes hôte — isolés par tenant
# Chemins résolus en relatif au compose file (infra/). Pour stocker
# ailleurs, mets des chemins absolus (ex. /srv/oc/site2/pgdata).
# -----------------------------------------------------------------
PGDATA_PATH=../data/site2/pgdata
RABBITMQ_DATA_PATH=../data/site2/rabbitmq
CUSTOM_PATH=../data/site2/custom
DOCSERVERS_PATH=../data/site2/docservers
SHARE_PATH=../data/site2/share

# -----------------------------------------------------------------
# Worker mail
# -----------------------------------------------------------------
# Intervalle en secondes entre 2 passes de l'IMAP poller (0 = une fois).
MAIL_POLL_INTERVAL=60
