script="MAIL"
name="$script.sh"

OCPath="§§BACKEND_PATH§§"
logFile="§§LOG_PATH§§"
PID=/tmp/securite-$script-$$.pid

§§PYTHON_VENV§§

if ! test -e $PID;
then
    touch $PID
    echo $$ > $PID
    python3 "$OCPath"/launch_worker_mail.py -c "§§CUSTOM_ID§§"
    rm -f $PID
else
    echo "[$name] $(date +"%d-%m-%Y %T") WARNING MAIL capture is already active : PID exists : $PID" >> "$logFile"
fi

