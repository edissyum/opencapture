; ----------------------
; General Settings
; ----------------------

[DEFAULT]
logfile=§§CUSTOM_PATH§§/data/log/daemon.log
pidfile=/run/watcher.pid
working_directory=/

; ----------------------
; Job Setups
; ----------------------

[verifier_default_workflow]
watch=§§SHARE_PATH§§/entrant/verifier/default/
events=write_close,move
include_extensions=pdf,PDF
command=§§CUSTOM_PATH§§/bin/scripts/verifier_workflows/default_workflow.sh $filename

[verifier_default_mail]
watch=§§SHARE_PATH§§/entrant/verifier/default_mail/
events=write_close,move
include_extensions=pdf,PDF
command=§§CUSTOM_PATH§§/bin/scripts/verifier_workflows/default_mail.sh $filename

[verifier_ocr_only]
watch=§§SHARE_PATH§§/entrant/verifier/ocr_only/
events=write_close,move
include_extensions=pdf,PDF
command=§§CUSTOM_PATH§§/bin/scripts/verifier_workflows/ocr_only.sh $filename

[splitter_default_workflow]
watch=§§SHARE_PATH§§/entrant/splitter/default/
events=write_close,move
include_extensions=pdf,PDF
command=§§CUSTOM_PATH§§/bin/scripts/splitter_workflows/default_workflow.sh $filename
