; ----------------------
; General Settings
; ----------------------

[DEFAULT]
logfile=§§CUSTOM_PATH§§/data/log/daemon.log
pidfile=/run/watcher.pid
working_directory=/

; ----------------------
; Job Setups
; ----------------------

;[verifier_default_workflow]
;watch=§§SHARE_PATH§§/entrant/verifier/
;events=close
;include_extensions=pdf,PDF
;command=§§CUSTOM_PATH§§/bin/scripts/verifier_workflows/default_workflow.sh $filename

;[splitter_default_workflow]
;watch=§§SHARE_PATH§§/entrant/splitter/
;events=close
;include_extensions=pdf,PDF
;command=§§CUSTOM_PATH§§/bin/scripts/splitter_workflows/default_workflow.sh $filename
