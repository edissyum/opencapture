[GLOBAL]
applicationUrl   =
applicationPath  = §§OC_PATH§§/
watcherConfig    = §§CUSTOM_PATH§§/config/watcher.ini
logFile          = §§CUSTOM_PATH§§/data/log/OpenCapture.log
; True or False
allowWFScripting = False
debugMode        = False

[SPLITTER]
docstart         = DOCSTART
bundlestart      = BUNDLESTART

[DATABASE]
postgresHost     = localhost
postgresPort     = 5432
postgresDatabase = opencapture_edissyum
postgresUser     =
postgresPassword =

[REFERENCIAL]
; CSV only supported
; Path is set up in docservers table (REFERENTIALS_PATH)
referencialSupplierDocument = default_referencial_supplier.csv
referencialSupplierIndex    = default_referencial_supplier_index.json

[SEPARATORQR]
; True or False
exportpdfa      = False
