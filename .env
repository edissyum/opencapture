# Open-Capture Docker — .env RACINE (stack "default" NEUTRE).
#
# Ce fichier sert uniquement quand on lance docker compose DEPUIS LA RACINE
# ou DEPUIS infra/ (le symlink infra/.env -> ../.env) — typiquement pour le
# dev/démo générique :
#   docker compose -f infra/docker-compose.yml \
#                  -f infra/docker-compose.override.yml up -d
#
# Il NE représente AUCUN tenant de production. Les vrais tenants ont chacun
# leur propre .env auto-suffisant sous tenants/<id>/.env et se lancent ainsi :
#   cd tenants/site1 && docker compose up -d
# (docker compose y charge tenants/site1/.env comme UNIQUE source ; ce
#  .env racine n'est alors PAS utilisé.)
#
# Structure identique à celle des .env tenant — seules les VALEURS changent.

# -----------------------------------------------------------------
# Identité (stack neutre par défaut)
# -----------------------------------------------------------------
CUSTOM_ID=default
# FQDN routé par Traefik. *.localhost est résolu en 127.0.0.1 par les
# navigateurs Chromium/Edge -> accessible depuis l'hôte sans /etc/hosts.
OC_FQDN=opencapture.localhost

# -----------------------------------------------------------------
# Compte de service (UID/GID interne des conteneurs backend)
# -----------------------------------------------------------------
# Les conteneurs backend (init, backend, workers, fs-watcher) démarrent
# en root puis droppent vers ce compte (gosu, cf. docker-entrypoint.sh).
APP_UID=1050
APP_GID=1050
APP_USER=opencapture

# -----------------------------------------------------------------
# Fuseau horaire des conteneurs
# -----------------------------------------------------------------
TZ=Europe/Paris

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée (le hostname interne `postgres` ne change pas)
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_default
POSTGRES_USER=opencapture
POSTGRES_PASSWORD=opencapture

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=opencapture
RABBITMQ_PASS=opencapture
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Frontend / Traefik
# -----------------------------------------------------------------
# Port hôte exposé par nginx (prod) en mode docker-compose.yml seul.
FRONTEND_PORT=8080
# Let's Encrypt (docker-compose.traefik-server-prod.yml uniquement).
# Email ACME -- doit être valide en prod (LE rejette example.com/test).
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_PATH=../data/letsencrypt

# -----------------------------------------------------------------
# Worker mail
# -----------------------------------------------------------------
# Intervalle en secondes entre 2 passes de l'IMAP poller (0 = une fois).
MAIL_POLL_INTERVAL=60

# -----------------------------------------------------------------
# Modèles IA PARTAGÉS (mêmes pour tous les tenants)
# -----------------------------------------------------------------
# Racine HÔTE bind-montée sur /app/instance/artificial_intelligence dans
# tous les services backend :
#   <racine>/rotate_document.pt  -> modèle de rotation (seedé au bootstrap si absent)
#   <racine>/contact/            -> modèle Qwen3-VL (format HF : config.json +
#                                   *.safetensors + tokenizer/processor ; vide =>
#                                   IA de contact désactivée proprement)
# Les modèles PROPRES au tenant (typologie) restent sous DOCSERVERS_PATH
# (.../verifier|splitter/ai/models). Pour partager entre tenants : même chemin.
SHARED_AI_MODELS_PATH=../data/shared-ai-models

# -----------------------------------------------------------------
# Volumes hôte (isolés par stack ; relatifs au compose file infra/)
# -----------------------------------------------------------------
PGDATA_PATH=../data/default/pgdata
RABBITMQ_DATA_PATH=../data/default/rabbitmq
CUSTOM_PATH=../data/default/custom
DOCSERVERS_PATH=../data/default/docservers
SHARE_PATH=../data/default/share

# -----------------------------------------------------------------
# Dev only — utilisé UNIQUEMENT avec infra/docker-compose.override.yml
# (ports hôte exposés pour introspection locale ; HMR Vite).
# Si plusieurs stacks tournent en mode dev en parallèle, donner des
# ports distincts par stack pour éviter les collisions.
# -----------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000/
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
