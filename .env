# Environment variables for Docker Compose

# Tenant identifier
CUSTOM_ID=edissyum

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_USER=edissyum
POSTGRES_PASSWORD=edissyum
POSTGRES_DB=opencapture_edissyum

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=edissyum
RABBITMQ_PASS=edissyum
RABBITMQ_VHOST=/opencapture

# Frontend (port hôte exposé par nginx)
FRONTEND_PORT=8080

# Mail worker
MAIL_POLL_INTERVAL=60

# Dev-only (compose.override.yml + legacy compose-dev.yml)
VITE_BACKEND_URL=http://localhost:8100/

# -----------------------------------------------------------------
# Volume paths on the HOST.
# Tous résolus par docker compose en relatif au dossier qui contient
# le compose (infra/), donc "../data/foo" pointe sur ./data/foo à la
# racine du repo. Mets des chemins ABSOLUS si tu veux stocker
# ailleurs (ex. /srv/opencapture/docservers).
# -----------------------------------------------------------------
PGDATA_PATH=../data/pgdata
RABBITMQ_DATA_PATH=../data/rabbitmq
CUSTOM_PATH=../data/custom
DOCSERVERS_PATH=../data/docservers
SHARE_PATH=../data/share
