# Environment variables for Docker Compose

# Tenant identifier (used by docker-compose.yml; ignored by docker-compose-dev.yml)
CUSTOM_ID=edissyum

# Document server path on local machine (legacy dev compose; ignored by the
# new docker-compose.yml which uses a named volume instead)
DOCSERVERS_PATH=/var/docservers/

# PostgreSQL default credentials
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_USER=edissyum
POSTGRES_PASSWORD=edissyum
POSTGRES_DB=opencapture_edissyum

# RabbitMQ default credentials
RABBITMQ_PORT=5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=edissyum
RABBITMQ_PASS=edissyum
RABBITMQ_VHOST=/opencapture

# Backend URL for frontend application
VITE_BACKEND_URL=http://localhost:8100/

