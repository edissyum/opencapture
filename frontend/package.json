{
    "name": "opencapture",
    "version": "4.0.0",
    "license": "GPL-3.0",
    "repository": "https://github.com/edissyum/opencapture",
    "author": "Edissyum Consulting <nathan.cheval@edissyum.com>",
    "description": "Open-Capture is the one and only 100% Open Source intelligent document capture solution",
    "private": true,
    "type": "module",
    "engines": {
        "npm": ">=11.13.0",
        "node": ">=24.16.0"
    },
    "scripts": {
        "dev": "vite",
        "check-update": "ncu",
        "preview": "vite preview",
        "build": "tsc -b && vite build",
        "prebuild": "npm run copy:tinymce",
        "postinstall": "npm run copy:tinymce",
        "copy:tinymce": "node ./postinstall_tinymce.js",
        "upgrade-all-packages-ncu": "ncu -u && npm run reload-packages",
        "reload-packages": "rm -Rf node_modules && rm -f package-lock.json && npm i",
        "extract-translations": "i18next-scanner --config i18next-scanner.config.cjs",
        "i18n:extract:merge": "npm run extract-translations && node src/assets/i18n/merge-i18n.mjs"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@hookform/resolvers": "^5.4.0",
        "@monaco-editor/react": "^4.7.0",
        "@tailwindcss/vite": "^4.3.2",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.14.4",
        "@tinymce/tinymce-react": "^6.3.0",
        "axios": "^1.18.1",
        "dayjs": "^1.11.21",
        "dompurify": "^3.4.11",
        "fs-extra": "^11.3.5",
        "i18next": "^26.3.3",
        "primereact": "^10.9.8",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-dropzone": "^15.0.0",
        "react-hook-form": "^7.80.0",
        "react-i18next": "^17.0.8",
        "react-pdf": "^10.4.1",
        "react-router-dom": "^7.18.0",
        "react-toastify": "^11.1.0",
        "react-tooltip": "^6.0.8",
        "recharts": "^3.9.0",
        "tailwindcss": "^4.3.2",
        "tinymce": "^8.6.0",
        "xlsx": "^0.18.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "i18next-scanner": "^4.6.0",
        "lucide-react": "^1.22.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.1.0"
    }
}
