{
    "name": "opencapture",
    "version": "4.0.0",
    "license": "GPL-3.0",
    "repository": "https://github.com/edissyum/opencapture",
    "author": "Edissyum Consulting <nathan.cheval@edissyum.com>",
    "description": "Open-Capture is the one and only 100% Open Source intelligent document capture solution",
    "private": true,
    "type": "module",
    "engines": {
        "npm": ">=11.13.0",
        "node": ">=24.16.0"
    },
    "scripts": {
        "dev": "vite",
        "check-update": "ncu",
        "prebuild": "npm run copy:tinymce",
        "build-prod": "tsc -b && vite build",
        "postinstall": "npm run copy:tinymce",
        "build-watch": "tsc -b && vite build --watch",
        "copy:tinymce": "node ./postinstall_tinymce.js",
        "upgrade-all-packages-ncu": "ncu -u && npm run reload-packages",
        "extract-translations": "i18next-scanner --config i18next-scanner.config.cjs",
        "copy-pdfjs-worker": "cp -R node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/",
        "i18n:extract:merge": "npm run extract-translations && node src/assets/i18n/merge-i18n.mjs",
        "reload-packages": "rm -Rf node_modules && rm -f package-lock.json && npm i && npm run copy-pdfjs-worker"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@hookform/resolvers": "^5.9.1",
        "@mantine/core": "^9.6.1",
        "@mantine/dates": "^9.6.1",
        "@mantine/hooks": "^9.6.1",
        "@monaco-editor/react": "^4.7.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-virtual": "^3.14.13",
        "@tinymce/tinymce-react": "^6.3.0",
        "axios": "^1.20.0",
        "dayjs": "^1.11.23",
        "dompurify": "^3.4.15",
        "fs-extra": "^11.4.0",
        "i18next": "^26.4.2",
        "papaparse": "^5.7.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-dropzone": "^20.1.2",
        "react-hook-form": "^7.88.0",
        "react-i18next": "^17.0.14",
        "react-pdf": "^11.0.0",
        "react-router-dom": "^7.18.4",
        "react-toastify": "^11.1.0",
        "react-tooltip": "^6.0.8",
        "recharts": "^3.10.1",
        "tailwindcss": "^4.3.3",
        "tinymce": "^8.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "i18next-scanner": "^4.6.0",
        "lucide-react": "^1.47.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0"
    }
}