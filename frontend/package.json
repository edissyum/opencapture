{
    "name": "opencapture",
    "version": "4.0.1",
    "license": "GPL-3.0",
    "repository": "https://github.com/edissyum/opencapture",
    "author": "Edissyum Consulting <nathan.cheval@edissyum.com>",
    "description": "Open-Capture is the one and only 100% Open Source intelligent document capture solution",
    "private": true,
    "type": "module",
    "engines": {
        "npm": ">=11.19.1",
        "node": ">=24.22.1"
    },
    "scripts": {
        "dev": "vite",
        "lint": "eslint .",
        "check-update": "ncu",
        "lint:fix": "eslint . --fix",
        "prebuild": "npm run copy:tinymce",
        "build-prod": "tsc -b && vite build",
        "postinstall": "npm run copy:tinymce",
        "build-watch": "tsc -b && vite build --watch",
        "copy:tinymce": "node ./postinstall_tinymce.js",
        "upgrade-all-packages-ncu": "ncu -u && npm run reload-packages",
        "extract-translations": "i18next-cli extract",
        "copy-pdfjs-worker": "cp -R node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/",
        "reload-packages": "rm -Rf node_modules && rm -f package-lock.json && npm i && npm run copy-pdfjs-worker"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@hookform/resolvers": "^7.0.3",
        "@mantine/core": "^9.7.5",
        "@mantine/dates": "^9.7.5",
        "@mantine/hooks": "^9.7.5",
        "@monaco-editor/react": "^4.7.0",
        "@tailwindcss/vite": "^4.3.4",
        "@tanstack/react-virtual": "^3.14.26",
        "@tinymce/tinymce-react": "^6.3.1",
        "axios": "^1.21.0",
        "dayjs": "^1.11.23",
        "dompurify": "^3.4.17",
        "fs-extra": "^11.4.1",
        "i18next": "^26.7.1",
        "papaparse": "^5.7.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-dropzone": "^20.1.4",
        "react-hook-form": "^7.91.0",
        "react-i18next": "^17.1.12",
        "react-pdf": "^11.0.0",
        "react-router-dom": "^7.18.5",
        "react-toastify": "^11.2.0",
        "react-tooltip": "^6.0.10",
        "recharts": "^3.10.1",
        "tailwindcss": "^4.3.4",
        "tinymce": "^8.10.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.6",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "i18next-cli": "^1.84.0",
        "lucide-react": "^1.69.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6"
    }
}
