{
    "name": "opencapture",
    "version": "4.0.0",
    "license": "GPL-3.0",
    "author": "Edissyum Consulting <nathan.cheval@edissyum.com>",
    "description": "Open-Capture is the one and only 100% Open Source intelligent document capture solution",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "check-update": "ncu",
        "preview": "vite preview",
        "build": "tsc -b && vite build",
        "postinstall": "node ./postinstall_tinymce.js",
        "upgrade-all-packages-ncu": "ncu -u && npm run reload-packages",
        "reload-packages": "rm -Rf node_modules && rm -f package-lock.json && npm i",
        "extract-translations": "i18next-scanner --config i18next-scanner.config.cjs",
        "i18n:extract:merge": "npm run extract-translations && node src/assets/i18n/merge-i18n.mjs"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@hookform/resolvers": "^5.2.2",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-table": "^8.21.3",
        "@tinymce/tinymce-react": "^6.3.0",
        "axios": "^1.13.2",
        "fs-extra": "^11.3.3",
        "i18next": "^25.7.4",
        "moment": "^2.30.1",
        "primereact": "^10.9.7",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-dropzone": "^14.3.8",
        "react-hook-form": "^7.70.0",
        "react-i18next": "^16.5.1",
        "react-pdf": "^10.3.0",
        "react-router-dom": "^7.12.0",
        "react-toastify": "^11.0.5",
        "react-tooltip": "^5.30.0",
        "tailwindcss": "^4.1.18",
        "tinymce": "^8.3.1",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "eslint": "^9.39.2",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^17.0.0",
        "i18next-scanner": "^4.6.0",
        "lucide-react": "^0.562.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.52.0",
        "vite": "^7.3.1"
    }
}
