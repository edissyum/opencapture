{
    "name": "opencapture",
    "version": "4.0.0",
    "license": "GPL-3.0",
    "repository": "https://github.com/edissyum/opencapture",
    "author": "Edissyum Consulting <nathan.cheval@edissyum.com>",
    "description": "Open-Capture is the one and only 100% Open Source intelligent document capture solution",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "check-update": "ncu",
        "preview": "vite preview",
        "build": "tsc -b && vite build",
        "postinstall": "node ./postinstall_tinymce.js",
        "upgrade-all-packages-ncu": "ncu -u && npm run reload-packages",
        "reload-packages": "rm -Rf node_modules && rm -f package-lock.json && npm i",
        "extract-translations": "i18next-scanner --config i18next-scanner.config.cjs",
        "i18n:extract:merge": "npm run extract-translations && node src/assets/i18n/merge-i18n.mjs"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@hookform/resolvers": "^5.2.2",
        "@monaco-editor/react": "^4.7.0",
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.13.24",
        "@tinymce/tinymce-react": "^6.3.0",
        "axios": "^1.16.1",
        "dayjs": "^1.11.20",
        "dompurify": "^3.4.5",
        "fs-extra": "^11.3.5",
        "i18next": "^26.2.0",
        "primereact": "^10.9.8",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-dropzone": "^15.0.0",
        "react-hook-form": "^7.76.0",
        "react-i18next": "^17.0.8",
        "react-pdf": "^10.4.1",
        "react-router-dom": "^7.15.1",
        "react-toastify": "^11.1.0",
        "react-tooltip": "^6.0.3",
        "recharts": "^3.8.1",
        "tailwindcss": "^4.3.0",
        "tinymce": "^8.5.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "i18next-scanner": "^4.6.0",
        "lucide-react": "^1.16.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.13"
    }
}
