{
    "name": "opencapture",
    "version": "4.0.0",
    "license": "GPL-3.0",
    "author": "Edissyum Consulting <nathan.cheval@edissyum.com>",
    "description": "Open-Capture is the one and only 100% Open Source intelligent document capture solution",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "lint": "eslint .",
        "check-update": "ncu",
        "preview": "vite preview",
        "build": "tsc -b && vite build",
        "upgrade-all-packages-ncu": "ncu -u && npm run reload-packages",
        "reload-packages": "rm -Rf node_modules && rm -f package-lock.json && npm i",
        "extract-translations": "i18next-scanner --config i18next-scanner.config.cjs",
        "i18n:extract:merge": "npm run extract-translations && node src/assets/i18n/merge-i18n.mjs"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.13",
        "axios": "^1.12.2",
        "i18next": "^25.5.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-i18next": "^15.7.3",
        "react-router-dom": "^7.9.1",
        "react-toastify": "^11.0.5",
        "react-tooltip": "^5.29.1",
        "tailwindcss": "^4.1.13"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.2",
        "eslint": "^9.35.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "fs-extra": "^11.3.2",
        "globals": "^16.4.0",
        "i18next-scanner": "^4.6.0",
        "lucide-react": "^0.544.0",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.44.0",
        "vite": "^7.1.5"
    }
}
