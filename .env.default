# Environment variables for Docker Compose

# Document server path on local machine
DOCSERVERS_PATH=/var/docservers/

# PostgreSQL default credentials
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_USER=edissyum
POSTGRES_PASSWORD=edissyum
POSTGRES_DB=opencapture_edissyum

# RabbitMQ default credentials
RABBITMQ_PORT=5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=edissyum
RABBITMQ_PASS=edissyum
RABBITMQ_VHOST=/opencapture

# Backend URL for frontend application
VITE_BACKEND_URL=http://localhost:8000/

