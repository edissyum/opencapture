# Tenant de TEST test2 — .env auto-chargé par docker compose (via
# --project-directory tests/tenants/test2). Harnais de tests : pas de
# Traefik, pas de port hôte. Data isolée sous tests/data/test2/*.
#
# Chemins data relatifs à infra/ (les volumes sont déclarés dans
# infra/docker-compose.yml) : ../tests/data/... => <racine>/tests/data/...

# -----------------------------------------------------------------
# Identité du tenant
# -----------------------------------------------------------------
CUSTOM_ID=test2
OC_FQDN=test2.edissyum.com

# -----------------------------------------------------------------
# Compte de service (UID/GID interne des conteneurs backend)
# -----------------------------------------------------------------
APP_UID=1050
APP_GID=1050
APP_USER=opencapture

# -----------------------------------------------------------------
# Fuseau horaire des conteneurs
# -----------------------------------------------------------------
TZ=Europe/Paris

# -----------------------------------------------------------------
# PostgreSQL — instance dédiée au tenant
# -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencapture_test2
POSTGRES_USER=test2
POSTGRES_PASSWORD=test2

# -----------------------------------------------------------------
# RabbitMQ — instance dédiée au tenant
# -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=test2
RABBITMQ_PASS=test2
RABBITMQ_VHOST=/opencapture

# -----------------------------------------------------------------
# Frontend / Traefik (non utilisés par le harnais de tests)
# -----------------------------------------------------------------
FRONTEND_PORT=8080
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_PATH=../tests/data/test2/letsencrypt

# -----------------------------------------------------------------
# Worker mail — l'overlay greenmail force MAIL_POLL_INTERVAL=0 au run.
# -----------------------------------------------------------------
MAIL_POLL_INTERVAL=60

# -----------------------------------------------------------------
# Modèles IA PARTAGÉS (rotate seedé au bootstrap si absent)
# -----------------------------------------------------------------
SHARED_AI_MODELS_PATH=../tests/data/shared-ai-models

# -----------------------------------------------------------------
# Volumes hôte — isolés par tenant (relatifs au compose file infra/)
# -----------------------------------------------------------------
PGDATA_PATH=../tests/data/test2/pgdata
RABBITMQ_DATA_PATH=../tests/data/test2/rabbitmq
CUSTOM_PATH=../tests/data/test2/custom
DOCSERVERS_PATH=../tests/data/test2/docservers
SHARE_PATH=../tests/data/test2/share

# -----------------------------------------------------------------
# Dev only — utilisé UNIQUEMENT avec infra/docker-compose.override.yml
# (non inclus par le harnais). Laissé pour cohérence de structure.
# -----------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8002/
BACKEND_HOST_PORT=8002
FRONTEND_HOST_PORT=5175
POSTGRES_HOST_PORT=5435
RABBITMQ_HOST_PORT=5674
RABBITMQ_MGMT_HOST_PORT=15674
